{
  "compilerOptions": {
    "allowJs": true,
    "module": "commonjs",
    "target": "ES2020",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": false,
    "sourceMap": true,
    "baseUrl": ".",
    "outDir": "out",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "jsx": "preserve",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@renderer/*": ["src/renderer/*"],
      "@/*": ["src/renderer/*"],
      "@shared/*": ["src/shared/*"],
      "*": ["node_modules/*"]
    },
    "typeRoots": ["./node_modules/@types", "./src/renderer/types"]
  },
  "include": [
    "src/renderer/**/*",
    "src/renderer/types/**/*",
    "src/shared/**/*"
  ]
}
