{
  "compilerOptions": {
    "allowJs": true,
    "module": "commonjs",
    "target": "ES2020",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "out",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "paths": {
      "*": ["node_modules/*"]
    }
  },
  "include": [
    "src/main/**/*",
    "src/shared/**/*"
  ]
}
