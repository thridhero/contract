{
  "name": "software-registration-manager",
  "version": "1.2.1",
  "description": "宏起行政助手",
  "main": "./out/main/main.js",
  "scripts": {
    "start": "chcp 65001 >nul && set ELECTRON_RUN_AS_NODE= && electron ./out/main/main.js",
    "dev": "chcp 65001 && npm run build && electron ./out/main/main.js",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "webpack --config webpack.renderer.config.js",
    "scan:loc": "node tools/scan-loc.js",
    "scan:loc:check": "node tools/scan-loc.js --check",
    "postinstall": "electron-builder install-app-deps",
    "setup-electron-cn": "npm config set electron_mirror=https://npmmirror.com/mirrors/electron/ && npm config set electron_custom_dir='{{ version }}'",
    "watch": "nodemon --watch src --ext ts,vue,js,css,html --exec \"npm run build\"",
    "dev:renderer": "webpack serve --config webpack.renderer.config.js",
    "dev:main": "tsc -p tsconfig.main.json",
    "electron:dev": "npm run build:main && set ELECTRON_RUN_AS_NODE= && cross-env NODE_ENV=development electron ./out/main/main.js",
    "test:unit": "npm run build:main && cross-env ELECTRON_RUN_AS_NODE=1 electron tests/unit-forms-validation.js && cross-env ELECTRON_RUN_AS_NODE=1 electron tests/unit-contract-create-read.js && cross-env ELECTRON_RUN_AS_NODE=1 electron tests/unit-contract-dialog-task5.js && cross-env ELECTRON_RUN_AS_NODE=1 electron tests/unit-project-management.js && cross-env ELECTRON_RUN_AS_NODE=1 electron tests/unit-ai-extract.js && cross-env ELECTRON_RUN_AS_NODE=1 electron tests/unit-ai-rag.js && cross-env ELECTRON_RUN_AS_NODE=1 electron tests/unit-ai-rag-integration.js && cross-env ELECTRON_RUN_AS_NODE=1 electron tests/unit-ai-rag-cleanup.js && cross-env ELECTRON_RUN_AS_NODE=1 electron tests/unit-db-backup-restore.js && cross-env ELECTRON_RUN_AS_NODE=1 electron tests/unit-ai-personnel-search-tool.js && cross-env ELECTRON_RUN_AS_NODE=1 electron tests/unit-ai-party-unit-search-tool.js && cross-env ELECTRON_RUN_AS_NODE=1 electron tests/unit-ai-invoice-search-tool.js && cross-env ELECTRON_RUN_AS_NODE=1 electron tests/unit-ai-product-search-tool.js && cross-env ELECTRON_RUN_AS_NODE=1 electron tests/unit-contract-statistics.js && cross-env ELECTRON_RUN_AS_NODE=1 electron tests/unit-agent-contract-statistics.js && node tests/unit-path-rename.js && node tests/unit-toolbox-pdf-merge.js && node tests/unit-toolbox-pdf-split.js && node tests/unit-invoice-layout-parser.js && electron tests/unit-toolbox-signature-cutout.js && electron tests/unit-toolbox-seal-extraction.js && electron tests/unit-toolbox-pdf-batch-stamp.js && electron tests/unit-toolbox-scan-enhance.js",
    "test:integration": "npm run build:main && node tests/integration-create-project.js && node tests/integration-project-management.js && cross-env ELECTRON_RUN_AS_NODE=1 electron tests/integration-ai-cloud-regression.js",
    "test:ai": "npm run build:main && node tests/unit-ai-structured.js && cross-env ELECTRON_RUN_AS_NODE=1 electron tests/unit-ai-local-e2e.js && cross-env ELECTRON_RUN_AS_NODE=1 electron tests/integration-ai-cloud-regression.js",
    "test:ai:rag-local": "npm run build:main && cross-env ELECTRON_RUN_AS_NODE=1 electron tests/e2e-ai-rag-local.js",
    "test:pdf-ocr": "npm run build:main && node tests/unit-pdf-ocr-markdown.js",
    "test:ocr-image": "npm run build:main && node tests/unit-paddleocr-image.js",
    "test:ocr-import-image": "npm run build:main && node tests/unit-import-image-ocr-flow.js",
    "test:toolbox-image-ocr": "npm run build:main && electron tests/unit-toolbox-image-ocr.js",
    "test:toolbox-pdf-compress": "npm run build:main && electron --disable-gpu --disable-gpu-sandbox --in-process-gpu tests/unit-toolbox-pdf-compress.js",
    "test:toolbox-scan-enhance": "npm run build:main && electron --disable-gpu --disable-gpu-sandbox --in-process-gpu tests/unit-toolbox-scan-enhance.js",
    "test:copy-lib": "npm run build:main && node tests/integration-copy-lib.js",
    "test:file-copy-engine": "npm run build:main && node tests/integration-file-copy-engine.js",
    "test:perf": "node tests/perf-thumbnail-generation.js",
    "test:stress": "npm run build:main && node tests/stress-create-project.js",
    "generate:contract-scan-samples": "ts-node --project tsconfig.main.json --transpile-only src/main/tools/generateContractScanSamples.ts",
    "convert:contract-scan-samples:docx": "ts-node --project tsconfig.main.json --transpile-only src/main/tools/convertContractScanSamplesToDocx.ts",
    "generate:icon:ico": "powershell -ExecutionPolicy Bypass -File tools/generate-icon-ico.ps1",
    "check:win-packaging-inputs": "node tools/check-win-packaging-inputs.js",
    "pack:win": "npm run check:win-packaging-inputs && electron-builder --win nsis",
    "build:win": "npm run build && npm run pack:win"
  },
  "keywords": [
    "Electron",
    "Vue",
    "TypeScript",
    "Software Registration",
    "Desktop App"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.18.0",
    "@babel/preset-env": "^7.18.0",
    "@babel/preset-typescript": "^7.28.5",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/iconv-lite": "^0.0.1",
    "@types/mark.js": "^8.11.12",
    "@types/node": "^18.0.0",
    "@vue/compiler-sfc": "^3.4.0",
    "@vue/tsconfig": "^0.1.3",
    "autoprefixer": "^10.4.27",
    "babel-loader": "^9.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.7.0",
    "electron": "^25.9.8",
    "electron-builder": "^24.0.0",
    "html-webpack-plugin": "^5.5.0",
    "nodemon": "^2.0.0",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.1",
    "sass": "^1.98.0",
    "sass-loader": "^16.0.7",
    "style-loader": "^3.3.0",
    "tailwindcss": "^4.0.0",
    "ts-loader": "^9.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "url-loader": "^4.1.1",
    "vue-loader": "^17.0.0",
    "vue-template-compiler": "^2.7.16",
    "webpack": "^5.73.0",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "^4.15.0"
  },
  "dependencies": {
    "@langchain/core": "^1.1.45",
    "@langchain/langgraph": "^1.3.0",
    "@primeuix/themes": "^2.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@vue-office/docx": "^1.6.3",
    "@vue-office/excel": "^1.7.14",
    "@vue-office/pptx": "^1.0.1",
    "@vueuse/core": "^14.2.1",
    "better-sqlite3": "^12.6.2",
    "csv-parser": "^3.2.0",
    "dompurify": "^3.4.2",
    "docx": "^9.6.1",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^5.0.0",
    "file2md": "^1.4.55",
    "fs-extra": "^11.3.4",
    "html2canvas": "^1.4.1",
    "iconv-lite": "^0.7.2",
    "jschardet": "^3.1.4",
    "mammoth": "^1.12.0",
    "mark.js": "^8.11.1",
    "markdown-it": "^14.1.1",
    "mitt": "^3.0.1",
    "p-limit": "^7.3.0",
    "pdf-lib": "^1.17.1",
    "pdf-to-markdown-converter": "^1.20.6",
    "pdfjs-dist": "^5.6.205",
    "pinia": "^3.0.4",
    "pinyin-pro": "^3.28.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.4",
    "qrcode": "^1.5.4",
    "quill": "^2.0.2",
    "sql.js": "^1.14.0",
    "turndown": "^7.2.4",
    "vee-validate": "^4.15.1",
    "vscode-material-icons": "^0.1.1",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5",
    "yup": "^1.7.1"
  },
  "build": {
    "appId": "com.example.software-registration-manager",
    "productName": "宏起助手",
    "icon": "build/icon.png",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/pdfjs-dist/**"
    ],
    "extraResources": [
      {
        "from": "resources/ocr",
        "to": "ocr"
      },
      {
        "from": "resources/dictionary/contract_settings_20260511.json",
        "to": "dictionary/contract_settings_20260511.json"
      },
      {
        "from": "resources/mineru",
        "to": "mineru"
      }
    ],
    "directories": {
      "output": "release/"
    },
    "files": [
      "out/**/*",
      "build/icon.ico",
      "build/icon.png",
      "resources/contract/contract_form_schema_seeds.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "electronConfig": {
    "mirror": "https://npmmirror.com/mirrors/electron/"
  }
}
